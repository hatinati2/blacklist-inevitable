{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "blacklist-inevitable",
  "version": "0.1.0",
  "identifier": "dev.blacklist.inevitable",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "blacklist-inevitable",
        "width": 1120,
        "height": 780,
        "minWidth": 760,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "connect-src": ["ipc:", "http://ipc.localhost"],
        "font-src": ["'self'", "data:"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "blob:", "data:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'self'"]
      },
      "devCsp": {
        "default-src": ["'self'"],
        "connect-src": ["ipc:", "http://ipc.localhost", "http://localhost:1420", "ws://localhost:1420"],
        "font-src": ["'self'", "data:"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "blob:", "data:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'self'"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
