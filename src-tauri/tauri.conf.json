{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "blacklist-inevitable",
  "version": "0.1.0",
  "identifier": "dev.blacklist.inevitable",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "blacklist-inevitable",
        "width": 1120,
        "height": 780,
        "minWidth": 760,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
